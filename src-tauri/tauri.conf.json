{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cognition OS",
  "version": "0.1.0",
  "identifier": "com.cognition-os.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Cognition OS",
